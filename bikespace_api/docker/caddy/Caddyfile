{
	servers {
		# Trust X-Forwarded-*
		trusted_proxies static private_ranges
	}
}

{$CADDY_SITE_ADDRESS::80} {
	encode zstd gzip
	log

	reverse_proxy bikespace_api:8000 {
		health_uri /api/v2/healthz
		health_interval 30s
		health_timeout 5s
	}
}

# Internal listener for container healthcheck
:2020 {
	respond /healthz "OK" 200
}
